# n8n Webhook Endpoint
# This is the URL of the n8n workflow trigger that receives lead submissions
# from the LeadForm component and kicks off AI qualification, Supabase storage,
# and the human-approval / outreach pipeline.
#
# For Vite projects, variable MUST be prefixed with VITE_
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/lead-intake

# For Next.js projects, variable MUST be prefixed with NEXT_PUBLIC_
# NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/lead-intake

# Optional: request timeout in milliseconds for the lead submission call
VITE_LEAD_SUBMIT_TIMEOUT_MS=15000
